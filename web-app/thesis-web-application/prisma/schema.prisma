generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String               @id @default(cuid())
  name                String
  email               String               @unique
  role                String?              @default("user")
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  emailVerified       Boolean              @default(false)
  image               String?
  animalTypes         String?
  phone               String?
  address             String?
  city                String?
  showPhone           Boolean              @default(false)
  showAddress         Boolean              @default(false)
  banned              Boolean?             @default(false)
  banReason           String?
  banExpires          DateTime?
  sessions            Session[]
  accounts            Account[]
  pets                Pet[]
  qrCodes             QrCode[]
  remindersAssigned   Reminder[]           @relation("ReminderAssignee")
  reminderCompletions ReminderCompletion[]
  notifications       Notification[]
  recordRequests      RecordRequest[]
  recordReports       RecordReport[]
  recordEdits         RecordEdit[]
  recordNotes         RecordNote[]
  finderThreads       MessageThread[]      @relation("ThreadFinder")
  sentMessages        Message[]
  threadReports       ThreadReport[]
  petShares           PetShare[]           @relation("ShareCaretaker")
  sharesSent          PetShare[]           @relation("ShareInviter")

  @@map("user")
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  impersonatedBy String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

enum QrStatus {
  UNUSED
  CLAIMED
  REVOKED
}

model QrCode {
  id           String    @id @default(cuid())
  code         String    @unique
  batch        String?
  status       QrStatus  @default(UNUSED)
  imageKey     String?
  createdById  String
  createdBy    User      @relation(fields: [createdById], references: [id])
  createdAt    DateTime  @default(now())
  claimedAt    DateTime?
  /// Set when the admin wrote this code's link onto a physical NFC tag, with that chip's serial number.
  nfcWrittenAt DateTime?
  nfcSerial    String?
  pet          Pet?

  @@index([batch])
  @@index([status])
  @@map("qr_code")
}

enum PetSex {
  MALE
  FEMALE
}

enum DocumentType {
  VACCINATION
  VET_VISIT
  LAB_RESULT
  OTHER
}

model Pet {
  id                   String             @id @default(cuid())
  name                 String
  species              String
  breed                String?
  color                String
  sex                  PetSex
  birthDate            DateTime
  birthDateApproximate Boolean            @default(false)
  neutered             Boolean?
  weightKg             Float?
  microchip            String?
  markings             String?
  medicalNotes         String?
  allergies            String?
  /// The large photo. New photos live in the pet-files bucket under photos/; older ones are
  /// pet-photos/... in the original bucket and keep working until replaced.
  photoKey             String?
  /// The small square copy used for avatars. Null for an older photo, which uses photoKey.
  photoThumbKey        String?
  lostMode             Boolean            @default(false)
  archivedAt           DateTime?
  ownerId              String
  owner                User               @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  qrCodeId             String?            @unique
  qrCode               QrCode?            @relation(fields: [qrCodeId], references: [id])
  documents            PetDocument[]
  records              HealthRecord[]
  reminders            Reminder[]
  recordRequests       RecordRequest[]
  appointments         Appointment[]
  publicSettings       PetPublicSettings?
  threads              MessageThread[]
  shares               PetShare[]
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@index([ownerId])
  @@map("pet")
}

model PetDocument {
  id           String        @id @default(cuid())
  petId        String
  pet          Pet           @relation(fields: [petId], references: [id], onDelete: Cascade)
  recordId     String?
  record       HealthRecord? @relation(fields: [recordId], references: [id], onDelete: SetNull)
  title        String
  type         DocumentType  @default(OTHER)
  documentDate DateTime?
  fileKey      String
  fileName     String
  contentType  String
  sizeBytes    Int
  uploadedAt   DateTime      @default(now())

  @@index([petId])
  @@map("pet_document")
}

enum RecordType {
  VACCINATION
  VET_VISIT
  LAB_RESULT
  MEDICATION
  WEIGHT
  OTHER
}

enum RecordSource {
  OWNER
  VET
}

model HealthRecord {
  id            String         @id @default(cuid())
  petId         String
  pet           Pet            @relation(fields: [petId], references: [id], onDelete: Cascade)
  type          RecordType
  title         String
  recordDate    DateTime
  clinic        String?
  vetName       String?
  notes         String?
  weightKg      Float?
  // Type-specific fields: vaccination (batchNumber, nextDueDate) and medication (dose, endDate;
  // the start date is recordDate).
  dose          String?
  batchNumber   String?
  endDate       DateTime?
  nextDueDate   DateTime?
  // Provenance: OWNER records are fully editable by the owner; VET records come from the
  // one-time QR form (Phase 4), keep the vet's name and clinic, and are read-only to owners.
  source        RecordSource   @default(OWNER)
  voidedAt      DateTime?
  voidedById    String?
  voidReason    String?
  files         PetDocument[]
  reminders     Reminder[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @default(now()) @updatedAt
  recordRequest RecordRequest?
  reports       RecordReport[]
  edits         RecordEdit[]
  addedNotes    RecordNote[]
  careTip       CareTip?

  @@index([petId, recordDate])
  @@map("health_record")
}

enum CareTipStatus {
  PENDING
  READY
  /// Nothing in the knowledge base matched, so no tips were written (never invented).
  NO_SOURCE
  FAILED
}

/// Owner-friendly care tips for a vet-saved medication or vaccination record. One per record.
model CareTip {
  id          String        @id @default(cuid())
  recordId    String        @unique
  record      HealthRecord  @relation(fields: [recordId], references: [id], onDelete: Cascade)
  status      CareTipStatus @default(PENDING)
  /// [{ text, sourceKeys }] in display order.
  tips        Json?
  /// The knowledge entries the tips came from: [{ key, name, source, url, reviewed }].
  sources     Json?
  /// Set when the pet's allergy text matches the drug (plain string match, not the model).
  allergyNote String?
  /// Why there are no tips (NO_SOURCE or FAILED), for the developer.
  detail      String?
  model       String?
  generatedAt DateTime?
  dismissedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @default(now()) @updatedAt

  @@index([status, createdAt])
  @@map("care_tip")
}

/// One searchable piece of a curated knowledge entry (knowledge/*.md). The embedding is a
/// pgvector column, so it is read and written with raw SQL.
model KnowledgeChunk {
  id            String                      @id @default(cuid())
  entryKey      String
  chunkIndex    Int
  name          String
  kind          String
  species       String[]
  aliases       String[]
  content       String
  sourceName    String
  sourceUrl     String
  sourceVersion String
  reviewed      Boolean                     @default(false)
  contentHash   String
  embedding     Unsupported("vector(768)")?
  updatedAt     DateTime                    @default(now()) @updatedAt

  @@unique([entryKey, chunkIndex])
  @@map("knowledge_chunk")
}

enum ReminderCategory {
  MEDICATION
  VACCINE
  FEEDING
  GROOMING
  EXERCISE
  HABITAT
  APPOINTMENT
  OTHER
}

enum ReminderRepeat {
  NONE
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

model Reminder {
  id              String               @id @default(cuid())
  petId           String
  pet             Pet                  @relation(fields: [petId], references: [id], onDelete: Cascade)
  title           String
  category        ReminderCategory     @default(OTHER)
  dueAt           DateTime
  repeat          ReminderRepeat       @default(NONE)
  /// Repeat interval: every N days, weeks, months or years.
  repeatEvery     Int                  @default(1)
  /// The reminder stops repeating after this date.
  endsAt          DateTime?
  remindDayBefore Boolean              @default(false)
  /// Free-text place, used by the Appointment type.
  place           String?
  /// On completion, also write a health record.
  addToRecords    Boolean              @default(false)
  assigneeId      String?
  assignee        User?                @relation("ReminderAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  /// Set for dose reminders made from a medication record.
  recordId        String?
  record          HealthRecord?        @relation(fields: [recordId], references: [id], onDelete: Cascade)
  completedAt     DateTime?
  createdAt       DateTime             @default(now())
  completions     ReminderCompletion[]

  @@index([petId, completedAt, dueAt])
  @@index([recordId])
  @@map("reminder")
}

model ReminderCompletion {
  id            String   @id @default(cuid())
  reminderId    String
  reminder      Reminder @relation(fields: [reminderId], references: [id], onDelete: Cascade)
  completedById String?
  completedBy   User?    @relation(fields: [completedById], references: [id], onDelete: SetNull)
  /// The due date that was completed.
  dueAt         DateTime
  completedAt   DateTime @default(now())

  @@index([reminderId, completedAt])
  @@index([completedAt])
  @@map("reminder_completion")
}

enum NotificationType {
  REMINDER_DUE
  REMINDER_OVERDUE
  REMINDER_SOON
  APPOINTMENT_SOON
  VET_RECORD
  LOST_MESSAGE
  SHARE_INVITE
  CARETAKER_COMPLETED
  CARE_TIPS
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String?
  href      String?
  /// One notification per user per event, so repeated checks never duplicate.
  dedupeKey String
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@unique([userId, dedupeKey])
  @@index([userId, readAt, createdAt])
  @@map("notification")
}

enum AppointmentStatus {
  UPCOMING
  DONE
  CANCELLED
}

model Appointment {
  id          String            @id @default(cuid())
  petId       String
  pet         Pet               @relation(fields: [petId], references: [id], onDelete: Cascade)
  title       String
  scheduledAt DateTime
  clinicName  String?
  status      AppointmentStatus @default(UPCOMING)
  createdAt   DateTime          @default(now())

  @@index([petId, scheduledAt])
  @@map("appointment")
}

/// What a vet may read on the public page. Basic info (name, species, age, sex) is always shown.
enum VetSection {
  ALLERGIES
  VACCINES
  MEDICATION
  NOTES
}

/// A one-time vet QR. The link carries a random token; only its hash is stored.
model RecordRequest {
  id               String        @id @default(cuid())
  petId            String
  pet              Pet           @relation(fields: [petId], references: [id], onDelete: Cascade)
  tokenHash        String        @unique
  sections         VetSection[]
  createdById      String
  createdBy        User          @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdAt        DateTime      @default(now())
  /// The link stops working to start with 24 hours after it was made.
  expiresAt        DateTime
  /// Set when the vet taps Start: the link is spent and a session begins.
  burnedAt         DateTime?
  /// Hash of the session secret held in the vet's cookie, and when that session ends.
  sessionHash      String?
  sessionExpiresAt DateTime?
  /// Set when the record is submitted: the QR is spent for good.
  usedAt           DateTime?
  recordId         String?       @unique
  record           HealthRecord? @relation(fields: [recordId], references: [id], onDelete: SetNull)
  revokedAt        DateTime?
  /// Upload URLs handed out in this session, capped.
  uploadCount      Int           @default(0)

  @@index([petId, createdAt])
  @@map("record_request")
}

/// Fixed-window counters for the public routes (serverless has no shared memory).
model RateLimit {
  key     String   @id
  count   Int
  resetAt DateTime

  @@map("rate_limit")
}

enum ReportStatus {
  OPEN
  /// The record was voided.
  RESOLVED
  /// The admin looked and left the record as it is.
  DISMISSED
}

/// An owner's report that a vet-submitted record is wrong or abusive. Admins read these.
model RecordReport {
  id           String       @id @default(cuid())
  recordId     String
  record       HealthRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)
  reporterId   String
  reporter     User         @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  reason       String
  status       ReportStatus @default(OPEN)
  createdAt    DateTime     @default(now())
  resolvedAt   DateTime?
  resolvedById String?

  @@index([status, createdAt])
  @@index([recordId])
  @@map("record_report")
}

enum AuditAction {
  RECORD_VOIDED
  REPORT_DISMISSED
}

/// Permanent admin audit trail. Rows are only ever added, and hold plain copies instead of
/// relations, so an entry survives the record, pet or admin it describes being deleted.
model AuditEntry {
  id          String      @id @default(cuid())
  action      AuditAction
  actorId     String
  actorName   String
  actorEmail  String
  recordId    String
  petId       String
  petName     String
  ownerEmail  String
  recordTitle String
  recordType  RecordType
  recordDate  DateTime
  vetName     String?
  clinic      String?
  reason      String
  createdAt   DateTime    @default(now())

  @@index([createdAt])
  @@index([recordId])
  @@map("audit_entry")
}

/// One saved change to a record: who, when, and each field's old and new value.
/// `changes` is a list of { field, from, to }. Add-only; shown as the record's history.
model RecordEdit {
  id        String       @id @default(cuid())
  recordId  String
  record    HealthRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)
  editorId  String?
  editor    User?        @relation(fields: [editorId], references: [id], onDelete: SetNull)
  changes   Json
  createdAt DateTime     @default(now())

  @@index([recordId, createdAt])
  @@map("record_edit")
}

/// A note added to a record after it was saved. Notes are only ever added, never edited.
model RecordNote {
  id        String       @id @default(cuid())
  recordId  String
  record    HealthRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)
  authorId  String?
  author    User?        @relation(fields: [authorId], references: [id], onDelete: SetNull)
  body      String
  createdAt DateTime     @default(now())

  @@index([recordId, createdAt])
  @@map("record_note")
}

/// What a stranger who scans a lost pet's tag may see, one switch per field. A pet without a
/// row uses these defaults. Nothing here is shown unless the pet is in lost mode.
model PetPublicSettings {
  petId          String   @id
  pet            Pet      @relation(fields: [petId], references: [id], onDelete: Cascade)
  showName       Boolean  @default(true)
  showSpecies    Boolean  @default(true)
  showAge        Boolean  @default(true)
  showGender     Boolean  @default(true)
  showOwnerName  Boolean  @default(true)
  showCity       Boolean  @default(false)
  /// Lets finders text or call the owner (the number is only in the button links).
  allowCall      Boolean  @default(false)
  /// Lets signed-in finders message the owner through the app.
  allowMessage   Boolean  @default(true)
  showAllergies  Boolean  @default(false)
  showVaccines   Boolean  @default(false)
  showMedication Boolean  @default(false)
  showNotes      Boolean  @default(false)
  /// The note shown on the scan page when showNotes is on.
  publicNote     String?
  updatedAt      DateTime @updatedAt

  @@map("pet_public_settings")
}

/// A conversation between a pet's owner and one signed-in finder who scanned its tag.
/// It only exists to be used while the pet is in lost mode.
model MessageThread {
  id            String         @id @default(cuid())
  petId         String
  pet           Pet            @relation(fields: [petId], references: [id], onDelete: Cascade)
  finderId      String
  finder        User           @relation("ThreadFinder", fields: [finderId], references: [id], onDelete: Cascade)
  createdAt     DateTime       @default(now())
  lastMessageAt DateTime       @default(now())
  /// When each side last opened the thread; newer messages from the other side are unread.
  ownerReadAt   DateTime?
  finderReadAt  DateTime?
  /// Set when either side blocks the thread or reports it; nobody can send until it is lifted.
  blockedAt     DateTime?
  blockedById   String?
  messages      Message[]
  reports       ThreadReport[]

  @@unique([petId, finderId])
  @@index([finderId, lastMessageAt])
  @@index([petId, lastMessageAt])
  @@map("message_thread")
}

model Message {
  id        String        @id @default(cuid())
  threadId  String
  thread    MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  senderId  String
  sender    User          @relation(fields: [senderId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime      @default(now())

  @@index([threadId, createdAt])
  @@map("message")
}

/// Either side can report a thread for abuse; admins read the transcript.
model ThreadReport {
  id           String        @id @default(cuid())
  threadId     String
  thread       MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  reporterId   String
  reporter     User          @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  reason       String
  status       ReportStatus  @default(OPEN)
  createdAt    DateTime      @default(now())
  resolvedAt   DateTime?
  resolvedById String?

  @@index([status, createdAt])
  @@map("thread_report")
}

enum ShareStatus {
  PENDING
  ACCEPTED
  DECLINED
}

/// A caretaker invited to help with a pet. Only an ACCEPTED row gives access (the "viewer"
/// role in pet-access.ts). Removing a caretaker deletes the row, so access ends at once.
model PetShare {
  id          String      @id @default(cuid())
  petId       String
  pet         Pet         @relation(fields: [petId], references: [id], onDelete: Cascade)
  userId      String
  user        User        @relation("ShareCaretaker", fields: [userId], references: [id], onDelete: Cascade)
  invitedById String
  invitedBy   User        @relation("ShareInviter", fields: [invitedById], references: [id], onDelete: Cascade)
  status      ShareStatus @default(PENDING)
  createdAt   DateTime    @default(now())
  respondedAt DateTime?

  @@unique([petId, userId])
  @@index([userId, status])
  @@map("pet_share")
}
