generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String               @id @default(cuid())
  name                String
  email               String               @unique
  role                String?              @default("user")
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  emailVerified       Boolean              @default(false)
  image               String?
  animalTypes         String?
  phone               String?
  address             String?
  showPhone           Boolean              @default(false)
  showAddress         Boolean              @default(false)
  banned              Boolean?             @default(false)
  banReason           String?
  banExpires          DateTime?
  sessions            Session[]
  accounts            Account[]
  pets                Pet[]
  qrCodes             QrCode[]
  remindersAssigned   Reminder[]           @relation("ReminderAssignee")
  reminderCompletions ReminderCompletion[]
  notifications       Notification[]
  recordRequests      RecordRequest[]

  @@map("user")
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  impersonatedBy String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

enum QrStatus {
  UNUSED
  CLAIMED
  REVOKED
}

model QrCode {
  id          String    @id @default(cuid())
  code        String    @unique
  batch       String?
  status      QrStatus  @default(UNUSED)
  imageKey    String?
  createdById String
  createdBy   User      @relation(fields: [createdById], references: [id])
  createdAt   DateTime  @default(now())
  claimedAt   DateTime?
  pet         Pet?

  @@index([batch])
  @@index([status])
  @@map("qr_code")
}

enum PetSex {
  MALE
  FEMALE
}

enum DocumentType {
  VACCINATION
  VET_VISIT
  LAB_RESULT
  OTHER
}

model Pet {
  id                   String          @id @default(cuid())
  name                 String
  species              String
  breed                String?
  color                String
  sex                  PetSex
  birthDate            DateTime
  birthDateApproximate Boolean         @default(false)
  neutered             Boolean?
  weightKg             Float?
  microchip            String?
  markings             String?
  medicalNotes         String?
  allergies            String?
  photoKey             String?
  lostMode             Boolean         @default(false)
  archivedAt           DateTime?
  ownerId              String
  owner                User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  qrCodeId             String?         @unique
  qrCode               QrCode?         @relation(fields: [qrCodeId], references: [id])
  documents            PetDocument[]
  records              HealthRecord[]
  reminders            Reminder[]
  recordRequests       RecordRequest[]
  appointments         Appointment[]
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  @@index([ownerId])
  @@map("pet")
}

model PetDocument {
  id           String        @id @default(cuid())
  petId        String
  pet          Pet           @relation(fields: [petId], references: [id], onDelete: Cascade)
  recordId     String?
  record       HealthRecord? @relation(fields: [recordId], references: [id], onDelete: SetNull)
  title        String
  type         DocumentType  @default(OTHER)
  documentDate DateTime?
  fileKey      String
  fileName     String
  contentType  String
  sizeBytes    Int
  uploadedAt   DateTime      @default(now())

  @@index([petId])
  @@map("pet_document")
}

enum RecordType {
  VACCINATION
  VET_VISIT
  LAB_RESULT
  MEDICATION
  WEIGHT
  OTHER
}

enum RecordSource {
  OWNER
  VET
}

model HealthRecord {
  id            String         @id @default(cuid())
  petId         String
  pet           Pet            @relation(fields: [petId], references: [id], onDelete: Cascade)
  type          RecordType
  title         String
  recordDate    DateTime
  clinic        String?
  vetName       String?
  notes         String?
  weightKg      Float?
  // Type-specific fields: vaccination (batchNumber, nextDueDate) and medication (dose, endDate;
  // the start date is recordDate).
  dose          String?
  batchNumber   String?
  endDate       DateTime?
  nextDueDate   DateTime?
  // Provenance: OWNER records are fully editable by the owner; VET records come from the
  // one-time QR form (Phase 4), keep the vet's name and clinic, and are read-only to owners.
  source        RecordSource   @default(OWNER)
  voidedAt      DateTime?
  voidedById    String?
  voidReason    String?
  files         PetDocument[]
  reminders     Reminder[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @default(now()) @updatedAt
  recordRequest RecordRequest?

  @@index([petId, recordDate])
  @@map("health_record")
}

enum ReminderCategory {
  MEDICATION
  VACCINE
  FEEDING
  GROOMING
  EXERCISE
  HABITAT
  APPOINTMENT
  OTHER
}

enum ReminderRepeat {
  NONE
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

model Reminder {
  id              String               @id @default(cuid())
  petId           String
  pet             Pet                  @relation(fields: [petId], references: [id], onDelete: Cascade)
  title           String
  category        ReminderCategory     @default(OTHER)
  dueAt           DateTime
  repeat          ReminderRepeat       @default(NONE)
  /// Repeat interval: every N days, weeks, months or years.
  repeatEvery     Int                  @default(1)
  /// The reminder stops repeating after this date.
  endsAt          DateTime?
  remindDayBefore Boolean              @default(false)
  /// Free-text place, used by the Appointment type.
  place           String?
  /// On completion, also write a health record.
  addToRecords    Boolean              @default(false)
  assigneeId      String?
  assignee        User?                @relation("ReminderAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  /// Set for dose reminders made from a medication record.
  recordId        String?
  record          HealthRecord?        @relation(fields: [recordId], references: [id], onDelete: Cascade)
  completedAt     DateTime?
  createdAt       DateTime             @default(now())
  completions     ReminderCompletion[]

  @@index([petId, completedAt, dueAt])
  @@index([recordId])
  @@map("reminder")
}

model ReminderCompletion {
  id            String   @id @default(cuid())
  reminderId    String
  reminder      Reminder @relation(fields: [reminderId], references: [id], onDelete: Cascade)
  completedById String?
  completedBy   User?    @relation(fields: [completedById], references: [id], onDelete: SetNull)
  /// The due date that was completed.
  dueAt         DateTime
  completedAt   DateTime @default(now())

  @@index([reminderId, completedAt])
  @@index([completedAt])
  @@map("reminder_completion")
}

enum NotificationType {
  REMINDER_DUE
  REMINDER_OVERDUE
  REMINDER_SOON
  APPOINTMENT_SOON
  VET_RECORD
  LOST_MESSAGE
  SHARE_INVITE
  CARETAKER_COMPLETED
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String?
  href      String?
  /// One notification per user per event, so repeated checks never duplicate.
  dedupeKey String
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@unique([userId, dedupeKey])
  @@index([userId, readAt, createdAt])
  @@map("notification")
}

enum AppointmentStatus {
  UPCOMING
  DONE
  CANCELLED
}

model Appointment {
  id          String            @id @default(cuid())
  petId       String
  pet         Pet               @relation(fields: [petId], references: [id], onDelete: Cascade)
  title       String
  scheduledAt DateTime
  clinicName  String?
  status      AppointmentStatus @default(UPCOMING)
  createdAt   DateTime          @default(now())

  @@index([petId, scheduledAt])
  @@map("appointment")
}

/// What a vet may read on the public page. Basic info (name, species, age, sex) is always shown.
enum VetSection {
  ALLERGIES
  VACCINES
  MEDICATION
  NOTES
}

/// A one-time vet QR. The link carries a random token; only its hash is stored.
model RecordRequest {
  id               String        @id @default(cuid())
  petId            String
  pet              Pet           @relation(fields: [petId], references: [id], onDelete: Cascade)
  tokenHash        String        @unique
  sections         VetSection[]
  createdById      String
  createdBy        User          @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdAt        DateTime      @default(now())
  /// The link stops working to start with 24 hours after it was made.
  expiresAt        DateTime
  /// Set when the vet taps Start: the link is spent and a session begins.
  burnedAt         DateTime?
  /// Hash of the session secret held in the vet's cookie, and when that session ends.
  sessionHash      String?
  sessionExpiresAt DateTime?
  /// Set when the record is submitted: the QR is spent for good.
  usedAt           DateTime?
  recordId         String?       @unique
  record           HealthRecord? @relation(fields: [recordId], references: [id], onDelete: SetNull)
  revokedAt        DateTime?
  /// Upload URLs handed out in this session, capped.
  uploadCount      Int           @default(0)

  @@index([petId, createdAt])
  @@map("record_request")
}

/// Fixed-window counters for the public routes (serverless has no shared memory).
model RateLimit {
  key     String   @id
  count   Int
  resetAt DateTime

  @@map("rate_limit")
}
