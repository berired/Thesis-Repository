generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  role          String?   @default("user")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  emailVerified Boolean   @default(false)
  image         String?
  animalTypes   String?
  banned        Boolean?  @default(false)
  banReason     String?
  banExpires    DateTime?
  sessions      Session[]
  accounts      Account[]
  pets          Pet[]
  qrCodes       QrCode[]

  @@map("user")
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  impersonatedBy String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

enum QrStatus {
  UNUSED
  CLAIMED
  REVOKED
}

model QrCode {
  id          String    @id @default(cuid())
  code        String    @unique
  batch       String?
  status      QrStatus  @default(UNUSED)
  imageKey    String?
  createdById String
  createdBy   User      @relation(fields: [createdById], references: [id])
  createdAt   DateTime  @default(now())
  claimedAt   DateTime?
  pet         Pet?

  @@index([batch])
  @@index([status])
  @@map("qr_code")
}

enum PetSex {
  MALE
  FEMALE
}

enum DocumentType {
  VACCINATION
  VET_VISIT
  LAB_RESULT
  OTHER
}

model Pet {
  id                   String         @id @default(cuid())
  name                 String
  species              String
  breed                String?
  color                String
  sex                  PetSex
  birthDate            DateTime
  birthDateApproximate Boolean        @default(false)
  neutered             Boolean?
  weightKg             Float?
  microchip            String?
  markings             String?
  medicalNotes         String?
  allergies            String?
  archivedAt           DateTime?
  ownerId              String
  owner                User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  qrCodeId             String?        @unique
  qrCode               QrCode?        @relation(fields: [qrCodeId], references: [id])
  documents            PetDocument[]
  records              HealthRecord[]
  reminders            Reminder[]
  appointments         Appointment[]
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  @@index([ownerId])
  @@map("pet")
}

model PetDocument {
  id           String        @id @default(cuid())
  petId        String
  pet          Pet           @relation(fields: [petId], references: [id], onDelete: Cascade)
  recordId     String?
  record       HealthRecord? @relation(fields: [recordId], references: [id], onDelete: SetNull)
  title        String
  type         DocumentType  @default(OTHER)
  documentDate DateTime?
  fileKey      String
  fileName     String
  contentType  String
  sizeBytes    Int
  uploadedAt   DateTime      @default(now())

  @@index([petId])
  @@map("pet_document")
}

enum RecordType {
  VACCINE
  WEIGHT
  CHECKUP
  MEDICATION
  LAB
}

model HealthRecord {
  id         String        @id @default(cuid())
  petId      String
  pet        Pet           @relation(fields: [petId], references: [id], onDelete: Cascade)
  type       RecordType
  title      String
  recordDate DateTime
  clinic     String?
  vetName    String?
  notes      String?
  weightKg   Float?
  files      PetDocument[]
  createdAt  DateTime      @default(now())

  @@index([petId, recordDate])
  @@map("health_record")
}

enum ReminderCategory {
  MEDICATION
  VACCINE
  CHECKUP
  CARE
  WALK
}

enum ReminderRepeat {
  NONE
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

model Reminder {
  id          String           @id @default(cuid())
  petId       String
  pet         Pet              @relation(fields: [petId], references: [id], onDelete: Cascade)
  title       String
  category    ReminderCategory @default(CARE)
  dueAt       DateTime
  repeat      ReminderRepeat   @default(NONE)
  completedAt DateTime?
  createdAt   DateTime         @default(now())

  @@index([petId, completedAt, dueAt])
  @@map("reminder")
}

enum AppointmentStatus {
  AWAITING_CLINIC
  CONFIRMED
  COMPLETED
  CANCELLED
}

model Appointment {
  id          String            @id @default(cuid())
  petId       String
  pet         Pet               @relation(fields: [petId], references: [id], onDelete: Cascade)
  title       String
  scheduledAt DateTime
  clinicName  String
  status      AppointmentStatus @default(AWAITING_CLINIC)
  createdAt   DateTime          @default(now())

  @@index([petId, scheduledAt])
  @@map("appointment")
}
